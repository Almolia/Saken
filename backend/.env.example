# SECURITY: required in production (DJANGO_DEBUG=False). The server refuses to
# start without it. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated hostnames the backend may serve. localhost/127.0.0.1, the
# Render hostname (RENDER_EXTERNAL_HOSTNAME) and GitHub Codespaces hosts are
# added automatically. Never use "*".
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional initial admin. No admin is created by `migrate`; set every value and
# run `python manage.py seed_admin` explicitly. Never commit real credentials.
SAKEN_ADMIN_PHONE=
SAKEN_ADMIN_USERNAME=
SAKEN_ADMIN_FULL_NAME=
SAKEN_ADMIN_NATIONAL_ID=
SAKEN_ADMIN_PASSWORD=

# Optional: extra frontend origins beyond localhost and auto-detected GitHub Codespaces URL
FRONTEND_EXTRA_ORIGINS=

# Optional manual overrides. localhost and the active GitHub Codespaces
# frontend URL are added automatically; *.vercel.app / *.onrender.com origins
# are allowed via regex. Use these to add any other exact origins.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ACCESS_COOKIE_NAME=saken_access_token
JWT_REFRESH_COOKIE_NAME=saken_refresh_token
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Optional: set when frontend is hosted on another public domain and you need
# cookies to be scoped for that host/domain.
FRONTEND_APP_URL=
AUTH_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_DOMAIN=
